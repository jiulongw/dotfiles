prepend_path "/opt/homebrew/bin"

source_if_exists "/opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme"
source_if_exists /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source_if_exists /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

export GOPATH=$HOME/go
export ANDROID_HOME=$HOME/Library/Android/sdk
export NDK_ROOT=$ANDROID_HOME/ndk/27.2.12479018
append_path "$NDK_ROOT"

export BUN_INSTALL="$HOME/.bun"
append_path "$BUN_INSTALL/bin"

prepend_path "/opt/homebrew/opt/ruby/bin"

# Build Vibe V1 android app requires openjdk@11
export JAVA_HOME="/opt/homebrew/opt/openjdk@11"
# export JAVA_HOME="/opt/homebrew/opt/openjdk@17"
# export JAVA_HOME="/opt/homebrew/opt/openjdk"
# Running sdkmanager requires newer openjdk. Use sdkman instead.
alias sdkman="JAVA_HOME=/opt/homebrew/opt/openjdk sdkmanager"

append_path "$HOME/dev/depot_tools"
append_path "$HOME/.cargo/bin"
append_path "/opt/homebrew/opt/libpq/bin"
append_path "/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/bin"

export PICO_SDK_PATH=$HOME/github/pico-sdk

if [[ -d "$HOME/.gem/bin" ]]; then
  append_path "$HOME/.gem/bin"
fi

export CLOUDSDK_PYTHON=/opt/homebrew/Cellar/python@3.14/3.14.10/bin/python3.14
